# Plantilla de configuración del puente para systemd.
#
# Copiar a /etc/rutautp/backend.env, rellenar y darle permisos 600. El archivo
# real NUNCA va al repositorio (ver .gitignore: backend/deploy/backend.env).
#
# Los nombres `MQTT_*` son los mismos que usa el Scheme de Xcode en la app, para
# poder copiar la configuración de un lado al otro sin traducirla.

# ── Broker ────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt.tu-dominio.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_CA_CERT=/etc/rutautp/certs/ca.crt
# El usuario `backend` de la ACL: lee observaciones y escribe vehiculos.
# Las credenciales de la app (`observer`) NO sirven aquí.
MQTT_USERNAME=backend
MQTT_PASSWORD=cambiame

# ── Feed ──────────────────────────────────────────────────────────────────
GTFS_DIR=/opt/rutautp/gtfs

# ── Persistencia ──────────────────────────────────────────────────────────
BACKEND_DB_PATH=/opt/rutautp/backend/data/rutautp.sqlite
# Días de histórico conservados. 0 (por defecto) no borra nunca: fijarlo antes
# de recoger datos de campo.
BACKEND_DB_RETENTION_DAYS=30

# ── Procedencia y entrada sintética (S03; mantener apagada) ───────────────
# Primero lectores S07/S08, ACL y migración/restauración verificadas.
# 1 conserva el legado de ocho claves; 2 publica la procedencia v2.
BACKEND_VEHICLE_POSITION_SCHEMA_VERSION=1
# Exige v2, quorum >=2 y un controlador interno con permiso vigente por run.
# La bandera sola no autoriza observaciones. No hay generador activo en S04.
BACKEND_SIMULATION_INGRESS_ENABLED=0
# Vacío desactiva el controlador. Su CLI init crea estado apagado en una carpeta
# privada; nunca se crea/recupera automáticamente al arrancar el backend.
# Ejemplo de ruta futura: /var/lib/rutautp/simulation-control/control.sqlite
BACKEND_SIMULATION_CONTROL_PATH=

# ── Salud ─────────────────────────────────────────────────────────────────
BACKEND_HEALTH_FILE=/opt/rutautp/backend/data/health.json

# ── Registro ──────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_JSON=1

# ── Avisos APNs (optativos; requieren Apple Developer) ────────────────────
# EMQX transporta registros; este proceso envia a Apple por HTTP/2.
# Sin estas credenciales reales no hay envio remoto. No usar la clave en iOS.
APNS_ENABLED=0
# development para builds de desarrollo; production para TestFlight/App Store.
APNS_ENVIRONMENT=development
APNS_TEAM_ID=
APNS_KEY_ID=
# Debe coincidir exactamente con el bundle ID del perfil de firma.
APNS_TOPIC=
APNS_KEY_PATH=/etc/rutautp/apns/AuthKey.p8
PUSH_DB_PATH=/opt/rutautp/backend/data/push.sqlite
