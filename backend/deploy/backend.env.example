# Plantilla de configuración del puente para systemd.
#
# Copiar a /etc/rutautp/backend.env, rellenar y darle permisos 600. El archivo
# real NUNCA va al repositorio (ver .gitignore: backend/deploy/backend.env).
#
# Los nombres `MQTT_*` son los mismos que usa el Scheme de Xcode en la app, para
# poder copiar la configuración de un lado al otro sin traducirla.

# ── Broker ────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt.tu-dominio.com
MQTT_PORT=8883
MQTT_TLS=1
MQTT_CA_CERT=/etc/rutautp/certs/ca.crt
# El usuario `backend` de la ACL: lee observaciones y escribe vehiculos.
# Las credenciales de la app (`observer`) NO sirven aquí.
MQTT_USERNAME=backend
MQTT_PASSWORD=cambiame

# ── Feed ──────────────────────────────────────────────────────────────────
GTFS_DIR=/opt/rutautp/gtfs

# ── Persistencia ──────────────────────────────────────────────────────────
BACKEND_DB_PATH=/opt/rutautp/backend/data/rutautp.sqlite
# Días de histórico conservados. 0 (por defecto) no borra nunca: fijarlo antes
# de recoger datos de campo.
BACKEND_DB_RETENTION_DAYS=30

# ── Salud ─────────────────────────────────────────────────────────────────
BACKEND_HEALTH_FILE=/opt/rutautp/backend/data/health.json

# ── Registro ──────────────────────────────────────────────────────────────
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_JSON=1
