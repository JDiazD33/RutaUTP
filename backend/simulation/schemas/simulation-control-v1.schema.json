{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rutautp:simulation:simulation-control:v1",
  "title": "Estado administrativo v1 con autorización temporal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enabled",
    "runId",
    "controlRevision",
    "issuedAt",
    "validUntil",
    "serviceEndsAt",
    "timeZone"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "controlRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "type": "number",
      "minimum": 0
    },
    "validUntil": {
      "type": "number",
      "minimum": 0
    },
    "serviceEndsAt": {
      "type": "number",
      "minimum": 0
    },
    "timeZone": {
      "const": "America/Lima"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "controlRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "controlRevision": {
            "const": 0
          }
        },
        "required": [
          "controlRevision"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": false
          },
          "runId": {
            "type": "null"
          }
        }
      }
    }
  ]
}
